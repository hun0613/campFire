# 이 파일을 복사해서 같은 폴더에 `.env` 로 저장하고 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)
# 곡 검색용 YouTube Data API v3 키
YT_API_KEY=

# (선택) 장작 저장 백업 서명용 아무 긴 문자열. 넣어두면 로컬 서버를 재시작해도 장작이 복원돼요
SAVE_SECRET=

# 방명록을 저장할 노션 연결 키 (노션 Integration 의 Internal Integration Secret, ntn_ 로 시작)
NOTION_TOKEN=
# 방명록 노션 데이터베이스 ID
NOTION_GUESTBOOK_DB=5c18c9a4ca29407fa760afe913914120

# 이용 분석용 Google Tag Manager 컨테이너 ID (GTM-로 시작). 비워 두면 분석 스크립트를 불러오지 않아요
VITE_GTM_ID=

# 관리자 페이지(/admin) 비밀번호 (8자 이상). 비워 두면 관리자 페이지가 꺼져요
ADMIN_PASSWORD=

# 관리실 📊 통계 탭: GA4 Data API 조회용
# GA4 속성 ID (숫자. G-로 시작하는 측정 ID 와는 달라요)
GA_PROPERTY_ID=
# 구글 서비스 계정 키. 직접 붙여 넣지 말고 `node scripts/set-ga-key.mjs <키파일> <속성ID>` 로 넣으세요
GA_SA_KEY=
